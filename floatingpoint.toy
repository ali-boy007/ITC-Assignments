10: 7A0E   R[A] <- 000E                  
11: 7B0A   R[B] <- 000A                  
12: 7C01   R[C] <- 0001                  
13: 7101   R[1] <- 0001                  
14: CC18   if (R[C] == 0) goto 18        
15: 6BB1   R[B] <- R[B] >> R[1]          
16: 2CC1   R[C] <- R[C] - R[1]           
17: C014   goto 14                       
18: 1DAB   R[D] <- R[A] + R[B]           
19: 9DFF   write R[D]                    
1A: 0000   halt                          